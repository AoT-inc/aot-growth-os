{
  "name": "aot-growth-os",
  "version": "0.0.0",
  "private": true,
  "description": "AoT Growth OS monorepo (Phase A skeleton)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:boundaries": "depcruise packages apps packs --config .dependency-cruiser.cjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:boundaries",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "test:boundaries": "node --test --test-concurrency=1 \"test/boundaries/**/*.test.ts\"",
    "check:schema": "sqlite3 :memory: < docs/schema/schema.sql",
    "scan:secrets": "node scripts/scan-secrets.mjs dir",
    "scan:history": "node scripts/scan-secrets.mjs git",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries && npm test && npm run check:schema && npm run scan:secrets",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
